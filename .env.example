# Supabase (EU-Region)
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# KI-Bewertung (austauschbar)
ASSESSMENT_PROVIDER=claude   # claude | gemini
ANTHROPIC_API_KEY=
GEMINI_API_KEY=

# Rohentwurf (proto/): KI-Zugang
# Mit OPENROUTER_API_KEY läuft alles über OpenRouter (ein Key für Gemini und Claude).
OPENROUTER_API_KEY=
# KI_PROVIDER=openrouter        # oder direct (dann GEMINI_API_KEY / ANTHROPIC_API_KEY oben)
# Modelle (Standard bei OpenRouter):
# SCAN_MODEL=google/gemini-3.8-flash          # günstiger: google/gemini-3.5-flash-lite
# ASSESS_MODEL=anthropic/claude-haiku-5.5
# ASSESS_MODEL_STRONG=anthropic/claude-sonnet-5.5
# SCAN_CHUNK_S=300                            # Länge eines Video-Abschnitts für Gemini in Sekunden
# ESCALATE_BELOW=0.6                          # unter dieser Sicherheit fragt das stärkere Modell

# Cloud-GPU-Worker
RUNPOD_API_KEY=
RUNPOD_ENDPOINT_ID=

# E-Mail-Benachrichtigungen
EMAIL_PROVIDER_API_KEY=
EMAIL_FROM=
